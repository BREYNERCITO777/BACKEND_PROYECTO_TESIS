# =====================================================================
# PLANTILLA DE CONFIGURACION DEL AGENTE SENTINEL
# =====================================================================
# Copia este archivo como .env y completa los valores reales:
#     cp .env.example .env
# El archivo .env NO se versiona porque contiene credenciales.

# --- Camara RTSP ---
# Formato: rtsp://USUARIO:CLAVE@IP:PUERTO/ruta
RTSP_URL=rtsp://usuario:clave@192.168.0.0:554/cam/realmonitor?channel=1&subtype=0

# --- Varias camaras en un solo agente (opcional) ---
# Si se define CAMARAS, reemplaza a RTSP_URL, CAMERA_ID y CAMERA_NAME. Un solo
# proceso atiende todas con el modelo compartido. Medido en una RTX 2070:
# 16 camaras a ~5.9 FPS cada una con 1.5 GB de RAM; solo CPU, ~4 camaras a
# 3 FPS. Una sola linea de JSON:
# CAMARAS=[{"id":"cam_01","nombre":"Frontis","rtsp_url":"rtsp://u:c@ip:554/..."},{"id":"cam_02","nombre":"Patio","rtsp_url":"rtsp://u:c@ip:554/..."}]

# --- Backend ---
# URL completa del endpoint que recibe las detecciones.
BACKEND_URL=https://tu-backend.onrender.com/api/v1/agent/detections

# Debe coincidir EXACTAMENTE con la variable AGENT_TOKEN del backend.
# Si no coincide, el backend responde 401.
AGENT_TOKEN=cambiame-por-un-token-largo-y-aleatorio

# --- Identificacion de la camara ---
# CAMERA_NAME: si coincide con el nombre de una camara registrada en el
# sistema, el backend vincula la deteccion con esa camara.
CAMERA_ID=cam_01
CAMERA_NAME=Nombre de la camara

# --- Modelo y deteccion ---
# MODEL_PATH: pesos YOLO dentro del contenedor.
#
# CONFIDENCE_MIN: confianza minima para ENVIAR al backend (0.0 a 1.0).
#   IMPORTANTE: el backend aplica su propio umbral, el del panel de
#   configuracion. Si el del backend es MAS ALTO que este, esas detecciones
#   se envian pero se descartan alla, y el agente las registra en su log como
#   "Deteccion NO registrada. Motivo: confianza_bajo_umbral".
#   Manten los dos valores iguales salvo que quieras ese filtrado doble.
#
# ALERT_COOLDOWN: segundos minimos entre dos envios al backend.
MODEL_PATH=best.pt
CONFIDENCE_MIN=0.65
ALERT_COOLDOWN=30

# --- Evidencia enviada al backend ---
# La imagen viaja en base64. El backend la limita a 4 MB.
EVIDENCE_WIDTH=960
EVIDENCE_HEIGHT=540
JPEG_QUALITY=85
