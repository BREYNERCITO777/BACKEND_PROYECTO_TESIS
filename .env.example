# Copia este archivo como .env y rellena los valores.
#
#     cp .env.example .env
#
# El .env real NUNCA se sube al repositorio: lleva contrasenas.


# ----------------------------------------------------------------------------
# OBLIGATORIAS
# Sin estas dos el backend no arranca o queda inseguro.
# ----------------------------------------------------------------------------

# Token compartido con el agente YOLO que corre en la municipalidad. Debe ser
# EXACTAMENTE el mismo valor que el AGENT_TOKEN del agente, o sus detecciones
# seran rechazadas con 401.
#
# Si falta, el backend se niega a arrancar: es intencionado. Un token de
# respaldo escrito en el codigo dejaria la puerta abierta a cualquiera.
#
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Clave con la que se firman las sesiones. Si alguien la conoce, puede
# fabricarse un token de administrador. Generala igual que la anterior.
JWT_SECRET=


# ----------------------------------------------------------------------------
# BASE DE DATOS
# ----------------------------------------------------------------------------

MONGO_URL=mongodb://localhost:27017
MONGO_DB=sistema_armas


# ----------------------------------------------------------------------------
# RECOMENDADAS
# ----------------------------------------------------------------------------

# Clave con la que se cifran las URL RTSP de las camaras antes de guardarlas,
# porque llevan usuario y contrasena de las camaras de la municipalidad.
# Si se deja vacia se usa JWT_SECRET.
#
# Cuidado: cambiarla despues de haber dado de alta camaras hace ilegibles las
# URL ya guardadas. Habria que volver a introducirlas desde el panel.
RTSP_SECRET_KEY=

# Desde que direcciones puede llamar el navegador. Separadas por comas, sin
# barra final. Si el frontend desplegado no aparece aqui, el navegador
# bloqueara las peticiones.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Direccion publica del backend. Se usa para construir los enlaces a las
# imagenes de evidencia. En produccion: https://tu-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:8000


# ----------------------------------------------------------------------------
# OPCIONALES  (los valores mostrados son los que se aplican si no las defines)
# ----------------------------------------------------------------------------

# Segundos minimos entre dos detecciones aceptadas de la MISMA camara. Sin
# esto, un agente detectando a 10 fps generaria 10 incidentes por segundo y
# ahogaria al operador. 0 lo desactiva.
# AGENT_COOLDOWN_SECONDS=5.0

# Tamano maximo de la foto de evidencia que se acepta del agente, en MB.
# MongoDB rechaza documentos de mas de 16 MB, asi que debe quedar por debajo.
# AGENT_MAX_EVIDENCE_MB=4.0

# Umbral de confianza de respaldo. Solo se usa la primera vez, cuando aun no
# existe la configuracion en la base. El valor que gobierna el sistema es el
# del panel (Configuracion), no este.
# CONF_TH=0.65

# Modelo YOLO que se carga al arrancar.
# MODEL_PATH=app/models/best.pt

# Duracion de la sesion en minutos (por defecto 24 horas).
# JWT_EXPIRE_MIN=1440
