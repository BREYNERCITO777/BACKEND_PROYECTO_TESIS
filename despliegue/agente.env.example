# Agente de detección cuando corre en el MISMO servidor que el backend
# (docker compose --profile agente). BACKEND_URL ya la fija docker-compose.yml.
#
#     cp agente.env.example agente.env      y completar
#
# Si el agente corre en otro equipo junto a las cámaras, usar en su lugar
# agente/docker-compose.yml con BACKEND_URL=http://<ip-del-servidor>/api/v1/agent/detections

AGENT_TOKEN=

# Una o varias cámaras, en una sola línea JSON (ver agente/.env.example):
CAMARAS=[{"id":"cam_01","nombre":"Jr. Ejemplo cuadra 1","rtsp_url":"rtsp://usuario:clave@192.168.0.10:554/cam/realmonitor?channel=1&subtype=0"}]

CONFIDENCE_MIN=0.65
ALERT_COOLDOWN=5
