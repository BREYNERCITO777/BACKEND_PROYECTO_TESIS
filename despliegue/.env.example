# Configuración del backend en el servidor de la municipalidad.
#
#     cp .env.example .env      y completar los valores
#
# El .env real NUNCA se sube al repositorio.
#
# Para generar cada clave:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Obligatorias ---------------------------------------------------------------

# Mismo valor que AGENT_TOKEN en agente.env (o en el .env del agente remoto).
AGENT_TOKEN=

# Firma de las sesiones del panel.
JWT_SECRET=

# Cifrado de las URL RTSP (llevan usuario y contraseña de las cámaras).
# No cambiarla después de dar de alta cámaras: las URL guardadas serían ilegibles.
RTSP_SECRET_KEY=

# Base de datos (MONGO_URL la fija docker-compose.yml: mongodb://mongo:27017).
MONGO_DB=sistema_armas

# Días que se conservan las imágenes de evidencia; pasado el plazo se borra la
# imagen y queda el registro del incidente. Lo fija la institución. 0 = no borrar.
EVIDENCE_RETENTION_DAYS=0

# Dirección con la que los operadores abren el panel (sin barra final).
# El panel y la API comparten dirección detrás de Nginx, así que basta con esta.
CORS_ORIGINS=http://192.168.10.20

# Opcionales (valores por defecto) ---------------------------------------------
# AGENT_COOLDOWN_SECONDS=5
# JWT_EXPIRE_MIN=1440
